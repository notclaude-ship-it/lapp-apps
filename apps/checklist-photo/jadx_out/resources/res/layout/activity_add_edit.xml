<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/md_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/md_primary"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">
        <ImageButton
            android:id="@+id/btn_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:tint="@color/md_on_primary"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_primary"
            android:id="@+id/txt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nouvel élément"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="140dp"
                android:layout_height="140dp">
                <ImageView
                    android:id="@+id/img_icon_preview"
                    android:background="@drawable/bg_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"/>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/btn_pick_icon"
                    android:background="@drawable/bg_fab"
                    android:padding="7dp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/md_on_primary"
                    android:contentDescription="@null"/>
            </FrameLayout>
            <EditText
                android:textColor="@color/md_on_surface"
                android:textColorHint="@color/md_on_surface_variant"
                android:id="@+id/edit_name"
                android:background="@drawable/bg_button_outline"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Nom (ex : Airbnb Appartement)"
                android:inputType="textCapSentences"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/md_on_surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Check-list"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/md_on_surface_variant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Étapes à cocher à chaque session"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/container_checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/md_primary"
                android:gravity="center"
                android:id="@+id/btn_add_row"
                android:background="@drawable/bg_add_tile"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ajouter une étape"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_add"
                android:drawableTint="@color/md_primary"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/md_on_primary"
                android:gravity="center"
                android:id="@+id/btn_save"
                android:background="@drawable/bg_button"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Enregistrer"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_error"
                android:gravity="center"
                android:id="@+id/btn_delete"
                android:background="@drawable/bg_button_outline"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:text="Supprimer cet élément"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
