<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">
    <EditText
        android:textColor="@color/md_on_surface"
        android:textColorHint="@color/md_on_surface_variant"
        android:id="@+id/edit_row_text"
        android:background="@drawable/bg_button_outline"
        android:padding="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Étape de la check-list"
        android:layout_weight="1"/>
    <ImageButton
        android:id="@+id/btn_row_delete"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_close"
        android:tint="@color/md_error"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"/>
</LinearLayout>
