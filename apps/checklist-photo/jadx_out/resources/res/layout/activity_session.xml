<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/md_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/md_primary"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">
        <ImageButton
            android:id="@+id/btn_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:tint="@color/md_on_primary"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_primary"
            android:id="@+id/txt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/md_on_primary_container"
        android:id="@+id/txt_step"
        android:background="@color/md_primary_container"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/panel_photos"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface"
            android:gravity="center"
            android:id="@+id/txt_photo_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container_photos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </HorizontalScrollView>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_take_photo"
            android:background="@drawable/bg_fab"
            android:padding="20dp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_camera"
            android:tint="@color/md_on_primary"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_primary"
            android:gravity="center"
            android:id="@+id/btn_photos_done"
            android:background="@drawable/bg_button"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Terminer les photos"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/panel_checklist"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/container_checklist_check"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_primary"
            android:gravity="center"
            android:id="@+id/btn_checklist_done"
            android:background="@drawable/bg_button"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="Continuer"/>
    </LinearLayout>
</LinearLayout>
